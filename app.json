{
  "expo": {
    "name": "lazycricscore",
    "slug": "lazycricscore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#020617"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.x24mca22.lazycricscore",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png",
      "bundler": "metro"
    },
    "scheme": "lazycricscore",
    "plugins": [
      "expo-router",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Allow LazyCricScore to access your microphone for voice scoring.",
          "speechRecognitionPermission": "Allow LazyCricScore to recognize your voice commands for scoring."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "315bb0b3-9737-4463-90a9-62501ff67818"
      }
    }
  }
}
